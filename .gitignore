# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# Local databases and runtime data (the platform is local-first)
data/*.sqlite
data/*.sqlite-wal
data/*.sqlite-shm
data/*.db

# Environment files / secrets
.env
.env.*
*.local

# Editors and OS noise
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Build artifacts
build/
dist/
*.egg-info/

# Frontend (M7)
node_modules/
dashboard/node_modules/
dashboard/dist/
dashboard/.vite/
dashboard/coverage/
